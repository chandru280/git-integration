DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave DATABASE_URL blank to fall back to sqlite3)
DATABASE_URL=sqlite:///db.sqlite3

# GitHub OAuth App (create one at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/integrations/github/callback/

# GitLab OAuth App (create one at https://gitlab.com/-/user_settings/applications)
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:8000/api/integrations/gitlab/callback/

# Automated background sync — Celery Beat triggers this every N minutes (today's data only)
GIT_SYNC_AUTOMATION_ENABLED=True
GIT_SYNC_INTERVAL_MINUTES=15

# Celery (requires a running Redis instance)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
